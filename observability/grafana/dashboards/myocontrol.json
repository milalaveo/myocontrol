{
  "title": "Myocontrol services",
  "uid": "myocontrol-services",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Service availability", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "up{job=\"myocontrol-services\"}", "refId": "A"}], "datasource": {"type": "prometheus", "uid": "prometheus"}},
    {"id": 2, "type": "timeseries", "title": "LDA runs by status", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by (status) (ml_experiments_runs)", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "95th percentile of session p95 processing (seconds)", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(recognition_replay_processing_p95_seconds_bucket[5m])))", "refId": "A"}]}
  ]
}
